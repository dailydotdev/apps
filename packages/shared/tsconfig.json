{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    // TypeScript 6+ no longer loads every @types package by default.
    "types": ["jest", "testing-library__jest-dom"],
    "paths": {
      // @growthbook's package.json "exports" maps have no "types" condition, so
      // `moduleResolution: bundler` cannot find their declarations and would
      // type every import from them as `any`. Point TS at the files directly.
      "@growthbook/growthbook": ["./node_modules/@growthbook/growthbook/dist/index.d.ts"],
      "@growthbook/growthbook-react": ["./node_modules/@growthbook/growthbook-react/dist/index.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "custom.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
