{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "config": "packages/shared/tailwind.config.ts",
    "functions": ["classnames", "clsx", "ctl", "classNames"]
  },
  "ignorePatterns": [
    "**/*.d.ts",
    "**/dist/**",
    "packages/webapp/build/**",
    "packages/webapp/next.config.js",
    "packages/webapp/public/push/onesignal/OneSignalSDKWorker.js",
    "packages/webapp/public/scripts/*.js",
    "packages/webapp/public/sw.js"
  ]
}
